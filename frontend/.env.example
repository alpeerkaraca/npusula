# Every frontend tunable lives here; src/config.js is the only reader, and no
# other module in src/ holds a magic number or touches import.meta.env.

# --- Transport --------------------------------------------------------------
# mock | backend | contract. `mock` uses sample data; `backend` talks to the
# real NPusula API; `contract` expects a service implementing /v1/pusula/*.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api
# Development-only proxy target (do not prefix secrets with VITE_).
API_PROXY_TARGET=http://127.0.0.1:8000
# Per-request budget, and the larger budgets for the two slow calls. Both must
# stay above the server's own GEMMA_TIMEOUT_SECONDS or the client gives up first.
VITE_REQUEST_TIMEOUT_MS=20000
VITE_ADVISOR_TIMEOUT_MS=120000
VITE_MEDIA_UPLOAD_TIMEOUT_MS=180000

# --- Behaviour --------------------------------------------------------------
# Sharing windows are computed in this zone unless a caller supplies one.
VITE_TIME_ZONE=Europe/Istanbul
# Must match MAX_IMAGE_MB / MAX_VIDEO_MB in backend/config.py, which enforce the
# same limits server-side; these only give an earlier, friendlier rejection.
VITE_MAX_IMAGE_MB=10
VITE_MAX_VIDEO_MB=50
# Mirrors detect_media_kind in backend/services/media_analysis.py.
VITE_ACCEPTED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/mov,video/webm
# How long each narrated stage of an advisor call shows before advancing.
VITE_ANALYSIS_STAGE_SECONDS=6
