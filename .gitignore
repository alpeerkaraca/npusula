# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
dist/
build/

# Pytest
.pytest_cache/

# Logs
*.log
artifacts/*.log

# Data directory - ignore data files, preserve folder structure via .gitkeep
data/**
!data/**/
!data/**/.gitkeep

# Media-analysis model weights (CLIP). ~600 MB: bind-mounted into the
# container, downloaded by scripts/download_clip_model.py, never committed.
# NOTE: artifacts/ is tracked by git, so weights must never be placed there.
models/**
!models/.gitkeep

# Secrets & agents
.env
.agents/
.claude/
graphify-out/
