# NPusula configuration template: copy to `.env` and fill in.
#
#   cp .env.example .env
#
# backend/env_loader.py loads `.env` into the process environment at startup
# (backend/config.py, backend/logging_setup.py and the scripts); the process
# environment always wins over the file. Every key has a built-in default, so
# an empty or missing `.env` still runs - keep this list in sync with .env.
# `.env` is gitignored: never commit real credentials.

# --- LLM (Ollama) ----------------------------------------------------------
GEMMA_API_URL=http://127.0.0.1:11434
# Ollama model id. The HuggingFace name `google/gemma-4-E4B-it` is not a
# registry name - `ollama pull` on it returns 404, so it must not be used here.
GEMMA_MODEL_NAME=gemma4:e4b

# --- Vector store (Qdrant) -------------------------------------------------
# Unset = auto-discovery (localhost, then the podman VM address); docker
# compose passes `qdrant` itself.
# QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Uploaded media analysis (photo/video -> CLIP zero-shot) ---------------
# Commented out = <repo>/models/hf, the path the container also sees.
# MEDIA_CACHE_DIR=<repo>/models/hf
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
# cpu | auto | cuda | directml
MEDIA_DEVICE=cpu
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=60
VIDEO_FRAME_COUNT=8
MEDIA_ANALYSIS_TTL_SECONDS=1800
MEDIA_TOP_TAGS=3
MEDIA_MIN_PROB=0.35
MEDIA_MIN_MARGIN=0.10
MEDIA_TAG_MIN_PROB=0.10

# --- Data pipeline ---------------------------------------------------------
SMPD_MEDIA_ROOT=data/raw/media

# --- Nextcloud WebDAV (corpus + artifact sync) -----------------------------
WEBDAV_URL=<your_nextcloud_url>
WEBDAV_USER=<your_nextcloud_username>
WEBDAV_PASSWORD=<your_nextcloud_app_password>

# --- Hugging Face ----------------------------------------------------------
# 1 = serve from the local weight cache, never touch the hub.
HF_HUB_OFFLINE=0

# --- Docker Compose --------------------------------------------------------
# Host port the API is published on.
API_PORT=8000

# --- NSosyal ingestion adapter -------------------------------------------
# Credentials issued by NSosyal; required only for real ingestion, never
# for the demo/fallback paths.
# NSOSYAL_API_BASE_URL=
# NSOSYAL_API_TOKEN=
# NSOSYAL_PSEUDONYM_SALT=
