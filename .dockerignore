# Keep the build context small: data and artifacts are bind-mounted at
# runtime, never baked into the image.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
data/
artifacts/
models/
tests/
.git/
.agents/
graphify-out/
*.log
*.md
!NOTICE.md

# Secrets: the image reads its environment from compose, never from .env.
.env
.env.*
